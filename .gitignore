# Compiled Go worker binaries. They are build output, not sources: rebuild them with the
# commands in docs/WORKER.md (`go build -o bin/<os>-<arch>/wt-worker ./cmd/wt-worker`).
# tools/New-ReleasePackage.ps1 does not build anything; it refuses to package a platform
# whose binary is missing, so an ignored binary is the one you built yourself.
worker/bin/

# Release archives, checksums and manifest written by tools/New-ReleasePackage.ps1.
dist/