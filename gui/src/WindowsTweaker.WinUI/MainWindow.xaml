<Window
    x:Class="WindowsTweaker.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsTweaker.WinUI">

    <Grid x:Name="RootGrid" Background="{StaticResource WtBase}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--
            Header: one compact status area. The connection state is the only session fact
            shown here; environment, protocol and runtime details live in Diagnostics, and
            the privilege is a single label rather than a repeated environment sentence.
        -->
        <Grid Grid.Row="0" Background="{StaticResource WtMantle}" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="WindowsTweaker" Style="{StaticResource WtPanelTitle}" Margin="0"/>
                <Border x:Name="ConnectionPill" Style="{StaticResource WtStatusPill}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border x:Name="ConnectionDot" Width="8" Height="8" CornerRadius="4"
                                Background="{StaticResource WtSurface2}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnectionText" Style="{StaticResource WtTerminalText}" FontSize="12"
                                   Text="{Binding ConnectionLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="PrivilegePill" Style="{StaticResource WtStatusPill}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource WtMutedText}" FontSize="12"
                               Text="{Binding PrivilegeLabel}" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding Strings[Gui.Header.Language]}" Style="{StaticResource WtMutedText}" VerticalAlignment="Center"/>
                <ComboBox x:Name="LanguageCombo" Style="{StaticResource WtComboBox}" MinWidth="140"
                          ItemsSource="{Binding AvailableLanguages}"
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox x:Name="ReduceMotionBox" Style="{StaticResource WtCheckBox}"
                          Content="{Binding Strings[Gui.Header.ReducedMotion]}"/>
                <Button x:Name="ElevateButton" Style="{StaticResource WtButton}"
                        Content="{Binding Strings[Gui.Header.Elevate]}"
                        IsEnabled="{Binding CanReconnect}"
                        ToolTipService.ToolTip="{Binding Strings[Gui.Header.ElevateHint]}"
                        AutomationProperties.Name="{Binding Strings[Gui.Header.ElevateHint]}"
                        Click="Elevate_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!--
            Recovery strip: shown whenever the connection is not ready - including after a
            session that was lost long after startup, which the previous build could not
            report at all. The window keeps showing what it has and says what happened.
        -->
        <Grid x:Name="RecoveryBanner" Grid.Row="1" Background="{StaticResource WtSurface0}"
              Padding="12,8" Visibility="{Binding RecoveryVisible, Converter={StaticResource WtBoolToVisible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Style="{StaticResource WtTerminalText}" TextWrapping="Wrap"
                           Text="{Binding RecoveryMessage}"/>
                <TextBlock Style="{StaticResource WtMutedText}" TextWrapping="Wrap"
                           Visibility="{Binding HasStaleData, Converter={StaticResource WtBoolToVisible}}"
                           Text="{Binding Strings[Gui.Data.Stale]}"/>
                <StackPanel x:Name="ConnectionDetailPanel" Spacing="4" Visibility="Collapsed">
                    <TextBox x:Name="ConnectionDetailBox" Style="{StaticResource WtTextBox}"
                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="150"
                             Text="{Binding ConnectionDetail, Mode=OneWay}"
                             AutomationProperties.Name="{Binding Strings[Gui.Diagnostics.Raw]}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="ConnectionDetailButton" Style="{StaticResource WtButton}"
                        Content="{Binding Strings[Gui.Diagnostics.Raw]}" Click="ConnectionDetail_Click"/>
                <Button x:Name="RetryBackendButton" Style="{StaticResource WtButton}"
                        IsEnabled="{Binding CanReconnect}" Click="RetryBackend_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource WtIconFont}" Glyph="&#xE72C;" FontSize="13"/>
                        <TextBlock Text="{Binding Strings[Gui.Action.Retry]}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Navigation + workspace. -->
        <Grid x:Name="WorkspaceHost" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListView x:Name="NavList" Grid.Column="0" Background="{StaticResource WtBase}"
                      SelectionChanged="NavList_SelectionChanged" IsItemClickEnabled="True">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="FontFamily" Value="{StaticResource WtMonoFont}"/>
                        <Setter Property="FontSize" Value="14"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListViewItem AutomationProperties.Name="{Binding Strings[Gui.Nav.Overview]}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="{StaticResource WtIconFont}" Glyph="&#xE80F;" FontSize="14"
                                  Foreground="{StaticResource WtSubtext}"/>
                        <TextBlock Text="{Binding Strings[Gui.Nav.Overview]}"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem AutomationProperties.Name="{Binding Strings[Gui.Nav.Tweaks]}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="{StaticResource WtIconFont}" Glyph="&#xE9F5;" FontSize="14"
                                  Foreground="{StaticResource WtSubtext}"/>
                        <TextBlock Text="{Binding Strings[Gui.Nav.Tweaks]}"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem AutomationProperties.Name="{Binding Strings[Gui.Nav.Review]}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="{StaticResource WtIconFont}" Glyph="&#xE8FB;" FontSize="14"
                                  Foreground="{StaticResource WtSubtext}"/>
                        <TextBlock Text="{Binding Strings[Gui.Nav.Review]}"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem AutomationProperties.Name="{Binding Strings[Gui.Nav.History]}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="{StaticResource WtIconFont}" Glyph="&#xE81C;" FontSize="14"
                                  Foreground="{StaticResource WtSubtext}"/>
                        <TextBlock Text="{Binding Strings[Gui.Nav.History]}"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem AutomationProperties.Name="{Binding Strings[Gui.Nav.Diagnostics]}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="{StaticResource WtIconFont}" Glyph="&#xE9D9;" FontSize="14"
                                  Foreground="{StaticResource WtSubtext}"/>
                        <TextBlock Text="{Binding Strings[Gui.Nav.Diagnostics]}"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem AutomationProperties.Name="{Binding Strings[Gui.Nav.Licensing]}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="{StaticResource WtIconFont}" Glyph="&#xE8D7;" FontSize="14"
                                  Foreground="{StaticResource WtSubtext}"/>
                        <TextBlock Text="{Binding Strings[Gui.Nav.Licensing]}"/>
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <Border Grid.Column="1" Background="{StaticResource WtSurface1}"/>

            <!-- Central workspace host: one panel per workspace, one visible at a time. -->
            <Grid Grid.Column="2" Background="{StaticResource WtBase}" Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Workspace title bar. -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Style="{StaticResource WtPanelTitle}" FontSize="16"
                                   Margin="0,0,0,6" Text="{Binding CurrentTitle}"/>
                        <Border Style="{StaticResource WtBadgeWarn}" VerticalAlignment="Center"
                                Margin="0,0,0,6"
                                Visibility="{Binding CurrentIsStale, Converter={StaticResource WtBoolToVisible}}">
                            <TextBlock Style="{StaticResource WtMutedText}" FontSize="11"
                                       Text="{Binding Strings[Gui.Data.Stale]}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                        <Button x:Name="RefreshButton" Style="{StaticResource WtButton}" Click="RefreshButton_Click"
                                IsEnabled="{Binding IsConnected}"
                                ToolTipService.ToolTip="{Binding Strings[Gui.Action.Refresh]}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource WtIconFont}" Glyph="&#xE72C;" FontSize="13"/>
                                <TextBlock Text="{Binding Strings[Gui.Action.Refresh]}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelButton" Style="{StaticResource WtButton}" Click="CancelButton_Click"
                                Visibility="{Binding Busy, Converter={StaticResource WtBoolToVisible}}"
                                ToolTipService.ToolTip="{Binding Strings[Gui.Action.Cancel]}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource WtIconFont}" Glyph="&#xE711;" FontSize="13"/>
                                <TextBlock Text="{Binding Strings[Gui.Action.Cancel]}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Overview: environment, catalog, pending work, and live local metrics. -->
                <Grid x:Name="OverviewPanel" Grid.Row="1" Visibility="Collapsed">
                    <ScrollViewer>
                        <StackPanel Spacing="12" Padding="0,0,0,16">

                            <!-- Header controls row: sampling status, last updated, refresh. -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                                Background="{StaticResource WtGreen}"
                                                Visibility="{Binding Overview.MetricsSampling, Converter={StaticResource WtBoolToVisible}}"/>
                                        <TextBlock Style="{StaticResource WtMutedText}" Text="{Binding Strings[Gui.Metrics.Sampling]}"/>
                                        <TextBlock Style="{StaticResource WtMutedText}" Text="{Binding Strings[Gui.Metrics.Paused]}"
                                                   Visibility="{Binding Overview.MetricsPaused, Converter={StaticResource WtBoolToVisible}}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource WtMutedText}" Text="{Binding Overview.MetricsUpdatedText}"/>
                                    <TextBlock Style="{StaticResource WtMutedText}" TextWrapping="Wrap"
                                               Foreground="{StaticResource WtYellow}"
                                               Text="{Binding Overview.StaleNote}"
                                               Visibility="{Binding Overview.QuadFresh, Converter={StaticResource WtBoolToCollapsed}}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource WtButton}" Click="RefreshButton_Click"
                                        IsEnabled="{Binding IsConnected}"
                                        ToolTipService.ToolTip="{Binding Strings[Gui.Action.Refresh]}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource WtIconFont}" Glyph="&#xE72C;" FontSize="13"/>
                                        <TextBlock Text="{Binding Strings[Gui.Action.Refresh]}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!--
                                Live local hardware gauges. Four cards in one row when there is
                                room, 2x2 below 1200 px, one column below 800 px (adaptive
                                triggers below). Each card is a GaugeControl bound to the
                                per-card view model values; a card that could not be measured
                                reports its own quality instead of drawing a zero.
                            -->
                            <Grid x:Name="MetricsCards" ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="MetricColumn0" Width="*"/>
                                    <ColumnDefinition x:Name="MetricColumn1" Width="*"/>
                                    <ColumnDefinition x:Name="MetricColumn2" Width="*"/>
                                    <ColumnDefinition x:Name="MetricColumn3" Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="CpuCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource WtPanel}">
                                    <local:GaugeControl
                                        Value="{Binding Overview.CpuPercent}"
                                        Quality="{Binding Overview.CpuQuality, Converter={StaticResource WtMetricQualityToGauge}}"
                                        Status="{Binding Overview.CpuPercent, Converter={StaticResource WtPercentToGaugeStatus}}"
                                        ValueText="{Binding Overview.CpuValueText}"
                                        SecondaryText="{Binding Overview.CpuDetailText}"
                                        MetricName="{Binding Strings[Gui.Metrics.Cpu]}"
                                        ReduceMotion="{Binding ReduceMotion}"/>
                                </Border>

                                <Border x:Name="GpuCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource WtPanel}">
                                    <local:GaugeControl
                                        Value="{Binding Overview.GpuUtilizationPercent}"
                                        Quality="{Binding Overview.GpuQuality, Converter={StaticResource WtMetricQualityToGauge}}"
                                        Status="{Binding Overview.GpuUtilizationPercent, Converter={StaticResource WtPercentToGaugeStatus}}"
                                        ValueText="{Binding Overview.GpuUtilizationText}"
                                        SecondaryText="{Binding Overview.GpuAdapterText}"
                                        MetricName="{Binding Strings[Gui.Metrics.Gpu]}"
                                        ReduceMotion="{Binding ReduceMotion}"/>
                                </Border>

                                <Border x:Name="RamCard" Grid.Row="0" Grid.Column="2" Style="{StaticResource WtPanel}">
                                    <local:GaugeControl
                                        Value="{Binding Overview.RamUsedPercent}"
                                        Quality="{Binding Overview.RamQuality, Converter={StaticResource WtMetricQualityToGauge}}"
                                        Status="{Binding Overview.RamUsedPercent, Converter={StaticResource WtPercentToGaugeStatus}}"
                                        ValueText="{Binding Overview.RamValueText}"
                                        SecondaryText="{Binding Overview.RamPercentText}"
                                        MetricName="{Binding Strings[Gui.Metrics.Ram]}"
                                        ReduceMotion="{Binding ReduceMotion}"/>
                                </Border>

                                <Border x:Name="DiskCard" Grid.Row="0" Grid.Column="3" Style="{StaticResource WtPanel}">
                                    <local:GaugeControl
                                        Value="{Binding Overview.DiskUsedPercent}"
                                        Quality="{Binding Overview.DiskQuality, Converter={StaticResource WtMetricQualityToGauge}}"
                                        Status="{Binding Overview.DiskUsedPercent, Converter={StaticResource WtPercentToGaugeStatus}}"
                                        ValueText="{Binding Overview.DiskValueText}"
                                        SecondaryText="{Binding Overview.DiskFreeText}"
                                        MetricName="{Binding Strings[Gui.Metrics.SystemDrive]}"
                                        ReduceMotion="{Binding ReduceMotion}"/>
                                </Border>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="MetricsWide">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="1200"/>
                                            </VisualState.StateTriggers>
                                        </VisualState>
                                        <VisualState x:Name="MetricsMedium">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="800"/>
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="MetricColumn2.Width" Value="0"/>
                                                <Setter Target="MetricColumn3.Width" Value="0"/>
                                                <Setter Target="RamCard.(Grid.Row)" Value="1"/>
                                                <Setter Target="RamCard.(Grid.Column)" Value="0"/>
                                                <Setter Target="DiskCard.(Grid.Row)" Value="1"/>
                                                <Setter Target="DiskCard.(Grid.Column)" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="MetricsNarrow">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="0"/>
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="MetricColumn1.Width" Value="0"/>
                                                <Setter Target="MetricColumn2.Width" Value="0"/>
                                                <Setter Target="MetricColumn3.Width" Value="0"/>
                                                <Setter Target="GpuCard.(Grid.Row)" Value="1"/>
                                                <Setter Target="GpuCard.(Grid.Column)" Value="0"/>
                                                <Setter Target="RamCard.(Grid.Row)" Value="2"/>
                                                <Setter Target="RamCard.(Grid.Column)" Value="0"/>
                                                <Setter Target="DiskCard.(Grid.Row)" Value="3"/>
                                                <Setter Target="DiskCard.(Grid.Column)" Value="0"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>

                            <!-- CPU and RAM line charts: visible axis baseline, unit labels, a
                                 legend with the current value, and one column per genuinely
                                 collected point (gaps are skipped, never zero-filled). -->
                            <Grid x:Name="MetricsCharts" ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition x:Name="ChartColumn1" Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="CpuChartPanel" Grid.Row="0" Grid.Column="0"
                                        Style="{StaticResource WtPanel}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource WtPanelTitle}" Margin="0"
                                                       Text="{Binding Strings[Gui.Metrics.Cpu]}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource WtTerminalText}" Text="{Binding Overview.CpuValueText}"/>
                                                <TextBlock Style="{StaticResource WtMutedText}" Text="{Binding Strings[Gui.Metrics.Trend]}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Height="110">
                                            <Border VerticalAlignment="Top" Height="1" Opacity="0.5"
                                                    Background="{StaticResource WtSurface1}"/>
                                            <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource WtSurface1}"/>
                                            <TextBlock Style="{StaticResource WtMutedText}" FontSize="11" Margin="0,0,4,0"
                                                       HorizontalAlignment="Right" VerticalAlignment="Top" Text="100%"/>
                                            <TextBlock Style="{StaticResource WtMutedText}" FontSize="11" Margin="0,0,4,0"
                                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Text="0%"/>
                                            <ItemsControl ItemsSource="{Binding Overview.CpuHistory}"
                                                          Visibility="{Binding Overview.CpuChartVisible, Converter={StaticResource WtBoolToVisible}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="1"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="3" VerticalAlignment="Bottom"
                                                                Background="{StaticResource WtBlue}"
                                                                Height="{Binding Value, Converter={StaticResource WtPercentToHeight}, ConverterParameter=106}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Style="{StaticResource WtMutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Text="{Binding Strings[Gui.Metrics.Loading]}"
                                                       Visibility="{Binding Overview.CpuChartVisible, Converter={StaticResource WtBoolToCollapsed}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="RamChartPanel" Grid.Row="0" Grid.Column="1"
                                        Style="{StaticResource WtPanel}" Padding="12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource WtPanelTitle}" Margin="0"
                                                       Text="{Binding Strings[Gui.Metrics.Ram]}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource WtTerminalText}" Text="{Binding Overview.RamValueText}"/>
                                                <TextBlock Style="{StaticResource WtMutedText}" Text="{Binding Strings[Gui.Metrics.Trend]}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Height="110">
                                            <Border VerticalAlignment="Top" Height="1" Opacity="0.5"
                                                    Background="{StaticResource WtSurface1}"/>
                                            <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource WtSurface1}"/>
                                            <TextBlock Style="{StaticResource WtMutedText}" FontSize="11" Margin="0,0,4,0"
                                                       HorizontalAlignment="Right" VerticalAlignment="Top" Text="100%"/>
                                            <TextBlock Style="{StaticResource WtMutedText}" FontSize="11" Margin="0,0,4,0"
                                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Text="0%"/>
                                            <ItemsControl ItemsSource="{Binding Overview.RamHistory}"
                                                          Visibility="{Binding Overview.RamChartVisible, Converter={StaticResource WtBoolToVisible}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="1"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="3" VerticalAlignment="Bottom"
                                                                Background="{StaticResource WtGreen}"
                                                                Height="{Binding Value, Converter={StaticResource WtPercentToHeight}, ConverterParameter=106}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Style="{StaticResource WtMutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Text="{Binding Strings[Gui.Metrics.Loading]}"
                                                       Visibility="{Binding Overview.RamChartVisible, Converter={StaticResource WtBoolToCollapsed}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="ChartsWide">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="800"/>
                                            </VisualState.StateTriggers>
                                        </VisualState>
                                        <VisualState x:Name="ChartsNarrow">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="0"/>
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="ChartColumn1.Width" Value="0"/>
                                                <Setter Target="RamChartPanel.(Grid.Column)" Value="0"/>
                                                <Setter Target="RamChartPanel.(Grid.Row)" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>

                            <!-- Supporting panels: environment, catalog, staged changes, interrupted operations. -->
                            <Border Style="{StaticResource WtPanel}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource WtPanelTitle}" Text="{Binding Strings[Gui.Overview.Environment]}"/>
                                    <Grid Margin="10,0,10,10" ColumnSpacing="10" RowSpacing="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource WtMutedText}" Text="{Binding Strings[Gui.Overview.Os]}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource WtTerminalText}" TextWrapping="Wrap" Text="{Binding Overview.OsText}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource WtMutedText}" Text="{Binding Strings[Gui.Overview.PowerShell]}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource WtTerminalText}" Text="{Binding Overview.PowerShellText}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource WtMutedText}" Text="{Binding Strings[Gui.Overview.Privilege]}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource WtTerminalText}" Text="{Binding Overview.PrivilegeText}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource WtMutedText}" Text="{Binding Strings[Gui.Overview.Engine]}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource WtTerminalText}" Text="{Binding Overview.EngineText}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource WtPanel}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource WtPanelTitle}" Text="{Binding Strings[Gui.Overview.Catalog]}"/>
                                    <TextBlock Style="{StaticResource WtTerminalText}" Margin="10,0,10,4"
                                               Text="{Binding Overview.CatalogSummary}"/>
                                    <TextBlock Style="{StaticResource WtMutedText}" Margin="10,0,10,10"
                                               Text="{Binding Strings[Gui.Overview.Loading]}"
                                               Visibility="{Binding Overview.IsLoading, Converter={StaticResource WtBoolToVisible}}"/>
                                    <StackPanel Margin="10,0,10,10" Spacing="6"
                                                Visibility="{Binding Overview.IsFailed, Converter={StaticResource WtBoolToVisible}}">
                                        <TextBlock Style="{StaticResource WtMutedText}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource WtRed}" Text="{Binding Overview.ErrorText}"/>
                                        <Button Style="{StaticResource WtButton}" HorizontalAlignment="Left"
                                                IsEnabled="{Binding IsConnected}"
                                                Click="RetryWorkspace_Click" Tag="overview">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="{StaticResource WtIconFont}" Glyph="&#xE72C;" FontSize="13"/>
                                                <TextBlock Text="{Binding Strings[Gui.Action.Retry]}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource WtPanel}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource WtPanelTitle}" Text="{Binding Strings[Gui.Overview.Pending]}"/>
                                    <TextBlock Style="{StaticResource WtTerminalText}" Margin="10,0,10,10"
                                               Text="{Binding Review.Changes.Count, Mode=OneWay}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource WtPanel}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource WtPanelTitle}" Text="{Binding Strings[Gui.Overview.Interrupted]}"/>
                                    <TextBlock Style="{StaticResource WtTerminalText}" Margin="10,0,10,4"
                                               Text="{Binding Overview.InterruptedCount, Mode=OneWay}"/>
                                    <!--
                                        Interrupted work is outstanding, not a neutral count: it is
                                        labelled in yellow and carries the action that opens the
                                        matching History view, only while the count is positive.
                                    -->
                                    <StackPanel Margin="10,0,10,10" Spacing="6"
                                                Visibility="{Binding Overview.InterruptedVisible, Converter={StaticResource WtBoolToVisible}}">
                                        <TextBlock Style="{StaticResource WtMutedText}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource WtYellow}"
                                                   Text="{Binding Overview.InterruptedNoteText}"/>
                                        <Button Style="{StaticResource WtButton}" HorizontalAlignment="Left"
                                                IsEnabled="{Binding IsConnected}"
                                                Click="OpenInterruptedHistory_Click"
                                                ToolTipService.ToolTip="{Binding Strings[Gui.Overview.InterruptedAction]}"
                                                AutomationProperties.Name="{Binding Strings[Gui.Overview.InterruptedAction]}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="{StaticResource WtIconFont}" Glyph="&#xE81C;" FontSize="13"/>
                                                <TextBlock Text="{Binding Strings[Gui.Overview.OpenHistory]}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!--
                    Tweaks: three labelled panes - filters and categories, the tweak list,
                    and the details of the selected row.
                -->
                <Grid x:Name="TweaksPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource WtSectionTitle}"
                                   Text="{Binding Strings[Gui.Column.Category]}"/>
                        <StackPanel Grid.Row="1" Spacing="8">
                            <TextBox x:Name="SearchBox" Style="{StaticResource WtTextBox}"
                                     PlaceholderText="{Binding Strings[Gui.Search]}"
                                     AutomationProperties.Name="{Binding Strings[Gui.Search]}"
                                     Text="{Binding Tweaks.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <ComboBox x:Name="CategoryCombo" Style="{StaticResource WtComboBox}"
                                      AutomationProperties.Name="{Binding Strings[Gui.Column.Category]}"
                                      ItemsSource="{Binding Tweaks.CategoryOptions}"
                                      SelectedValue="{Binding Tweaks.Category, Mode=TwoWay}"
                                      SelectedValuePath="Code"
                                      DisplayMemberPath="Label"/>
                            <CheckBox x:Name="OnlySupportedBox" Style="{StaticResource WtCheckBox}"
                                      Content="{Binding Strings[Gui.Tweaks.OnlySupported]}"
                                      IsChecked="{Binding Tweaks.OnlySupported, Mode=TwoWay}"/>
                            <TextBlock Style="{StaticResource WtMutedText}" TextWrapping="Wrap"
                                       Text="{Binding Tweaks.RowsSummary}"/>
                            <TextBlock Style="{StaticResource WtMutedText}" TextWrapping="Wrap"
                                       Text="{Binding Strings[Gui.Tweaks.Loading]}"
                                       Visibility="{Binding Tweaks.IsLoading, Converter={StaticResource WtBoolToVisible}}"/>
                            <TextBlock Style="{StaticResource WtMutedText}" TextWrapping="Wrap"
                                       Text="{Binding Tweaks.EmptyMessage}"
                                       Visibility="{Binding Tweaks.ShowFilteredEmpty, Converter={StaticResource WtBoolToVisible}}"/>
                            <TextBlock Style="{StaticResource WtMutedText}" TextWrapping="Wrap"
                                       Text="{Binding Strings[Gui.Overview.Empty]}"
                                       Visibility="{Binding Tweaks.ShowCatalogEmpty, Converter={StaticResource WtBoolToVisible}}"/>
                            <StackPanel Spacing="6"
                                        Visibility="{Binding Tweaks.IsFailed, Converter={StaticResource WtBoolToVisible}}">
                                <TextBlock Style="{StaticResource WtMutedText}" TextWrapping="Wrap"
                                           Foreground="{StaticResource WtRed}" Text="{Binding Tweaks.ErrorText}"/>
                                <Button Style="{StaticResource WtButton}" HorizontalAlignment="Left"
                                        IsEnabled="{Binding IsConnected}"
                                        Click="RetryWorkspace_Click" Tag="tweaks">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource WtIconFont}" Glyph="&#xE72C;" FontSize="13"/>
                                        <TextBlock Text="{Binding Strings[Gui.Action.Retry]}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBox Style="{StaticResource WtTextBox}" IsReadOnly="True" TextWrapping="Wrap"
                                         AcceptsReturn="True" MaxHeight="120"
                                         Text="{Binding Tweaks.ErrorDetail, Mode=OneWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="1" Background="{StaticResource WtSurface1}"/>

                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource WtSectionTitle}"
                                       Text="{Binding Strings[Gui.Nav.Tweaks]}"/>
                            <!--
                                One header grid and one row template with identical column
                                definitions, so a value can never drift away from its header.
                                The name column takes the flexible space; the id and value
                                columns are fixed so rows line up whatever the id length is.
                            -->
                            <Grid Grid.Row="1" Padding="8,4" ColumnSpacing="8" Background="{StaticResource WtSurface0}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource WtColumnHeader}" Text="{Binding Strings[Gui.Tweaks.ColumnName]}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource WtColumnHeader}" Text="{Binding Strings[Gui.Column.Operation]}"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource WtColumnHeader}" Text="{Binding Strings[Gui.Tweaks.ColumnValue]}"/>
                            </Grid>
                            <ListView x:Name="TweakList" Grid.Row="2" Background="{StaticResource WtMantle}"
                                      SelectionMode="Single"
                                      ItemsSource="{Binding Tweaks.States}"
                                      SelectedItem="{Binding Tweaks.Selected, Mode=TwoWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,6" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource WtTerminalText}"
                                                       TextTrimming="CharacterEllipsis" Text="{Binding Name}"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource WtMutedText}"
                                                       TextTrimming="CharacterEllipsis" Text="{Binding SecondaryText}"
                                                       ToolTipService.ToolTip="{Binding SecondaryText}"/>
                                            <!-- The status colour belongs to the value only: the
                                                 selected row keeps the list's own selection and
                                                 focus visuals, independently of this tone. -->
                                            <TextBlock Grid.Column="2" Style="{StaticResource WtTerminalText}"
                                                       Foreground="{Binding ValueTone, Converter={StaticResource WtToneToBrush}}"
                                                       Text="{Binding ValueText}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <Border Grid.Column="1" Background="{StaticResource WtSurface1}"/>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource WtSectionTitle}"
                                       Text="{Binding Strings[Gui.Details]}"/>
                            <ScrollViewer Grid.Row="1" Background="{StaticResource WtMantle}">
                                <StackPanel Padding="12" Spacing="10">
                                    <TextBlock Style="{StaticResource WtPanelTitle}"
                                               Text="{Binding Tweaks.DetailsTitle}"/>

                                    <!-- Description, impact, compatibility and privileges are
                                         separate facts, never one run-on paragraph. -->
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource WtMutedText}" Text="{Binding Strings[Gui.Tweaks.DetailDescription]}"/>
                                        <TextBlock Style="{StaticResource WtBodyText}" TextWrapping="Wrap"
                                                   Text="{Binding Tweaks.DetailDescription}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource WtMutedText}" Text="{Binding Strings[Gui.Tweaks.DetailImpact]}"/>
                                        <TextBlock Style="{StaticResource WtBodyText}" TextWrapping="Wrap"
                                                   Text="{Binding Tweaks.DetailImpact}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource WtMutedText}" Text="{Binding Strings[Gui.Tweaks.DetailCompatibility]}"/>
                                        <TextBlock Style="{StaticResource WtBodyText}" TextWrapping="Wrap"
                                                   Text="{Binding Tweaks.DetailCompatibility}"/>
                                        <!-- A recoverable privilege requirement and an
                                             incompatible OS are different answers. -->
                                        <TextBlock Style="{StaticResource WtMutedText}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource WtYellow}"
                                                   Text="{Binding Strings[Gui.Tweaks.RequiresAdmin]}"
                                                   Visibility="{Binding Tweaks.RequiresElevation, Converter={StaticResource WtBoolToVisible}}"/>
                                        <TextBlock Style="{StaticResource WtMutedText}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource WtRed}"
                                                   Text="{Binding Strings[Gui.Tweaks.IncompatibleOs]}"
                                                   Visibility="{Binding Tweaks.OsIncompatible, Converter={StaticResource WtBoolToVisible}}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource WtMutedText}" Text="{Binding Strings[Gui.Tweaks.DetailPrivileges]}"/>
                                        <TextBlock Style="{StaticResource WtBodyText}" TextWrapping="Wrap"
                                                   Text="{Binding Tweaks.DetailPrivileges}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource WtMutedText}" Text="{Binding Strings[Gui.Tweaks.DetailTarget]}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ComboBox Style="{StaticResource WtComboBox}" MinWidth="140"
                                                      ItemsSource="{Binding Tweaks.Selected.StateNames, Mode=OneWay}"
                                                      SelectedItem="{Binding Tweaks.TargetState, Mode=TwoWay}"/>
                                            <TextBlock Style="{StaticResource WtTerminalText}" VerticalAlignment="Center"
                                                       Text="{Binding Tweaks.DetailTargetValue}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource WtTerminalText}" TextWrapping="Wrap"
                                               Text="{Binding Tweaks.DetailsBody}"/>

                                    <Button Style="{StaticResource WtAccentButton}"
                                            Content="{Binding Strings[Gui.Tweaks.StageAction]}"
                                            IsEnabled="{Binding Tweaks.CanStage}"
                                            Click="AddPending_Click"/>
                                    <TextBlock Style="{StaticResource WtMutedText}" TextWrapping="Wrap"
                                               Foreground="{StaticResource WtYellow}"
                                               Text="{Binding Tweaks.StageBlockedReason}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Review: staging area for changes that have not been applied. -->
                <Grid x:Name="ReviewPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!--
                        The summary and the layout come from the real staged count: with
                        nothing staged the panel offers exactly one next action, and the
                        preview area is collapsed rather than showing an empty box.
                    -->
                    <Grid Grid.Row="0" Margin="0,0,0,8"
                          Visibility="{Binding Review.HasChanges, Converter={StaticResource WtBoolToVisible}}">
                        <TextBlock Style="{StaticResource WtMutedText}" TextWrapping="Wrap"
                                   Text="{Binding Strings[Gui.Review.Staged]}"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="10" VerticalAlignment="Top"
                                Visibility="{Binding Review.IsEmptyState, Converter={StaticResource WtBoolToVisible}}">
                        <TextBlock Style="{StaticResource WtBodyText}" TextWrapping="Wrap"
                                   Text="{Binding Review.EmptyStateMessage}"/>
                        <Button Style="{StaticResource WtAccentButton}" HorizontalAlignment="Left"
                                Click="ReviewGoToTweaks_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource WtIconFont}" Glyph="&#xE9F5;" FontSize="13"/>
                                <TextBlock Text="{Binding Review.EmptyStateAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="1"
                          Visibility="{Binding Review.HasChanges, Converter={StaticResource WtBoolToVisible}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource WtSectionTitle}"
                                           Text="{Binding Strings[Gui.Review.Title]}"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource WtMutedText}" TextWrapping="Wrap"
                                           Margin="0,0,0,6" Text="{Binding Strings[Gui.Review.Empty]}"
                                           Visibility="{Binding Review.HasChanges, Converter={StaticResource WtBoolToCollapsed}}"/>
                                <ListView x:Name="ReviewList" Grid.Row="2" Background="{StaticResource WtMantle}"
                                          SelectionMode="Single" ItemsSource="{Binding Review.Changes}"
                                          SelectedItem="{Binding Review.SelectedChange, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8,6" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Style="{StaticResource WtTerminalText}"
                                                               TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}"/>
                                                    <TextBlock Style="{StaticResource WtMutedText}"
                                                               TextTrimming="CharacterEllipsis" Text="{Binding SecondaryText}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Style="{StaticResource WtMutedText}"
                                                           Text="{Binding CurrentValueText}"/>
                                                <TextBlock Grid.Column="2" Style="{StaticResource WtTerminalText}"
                                                           Text="{Binding RequestedValueText}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <Border Grid.Column="1" Background="{StaticResource WtSurface1}"/>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource WtSectionTitle}"
                                           Text="{Binding Strings[Gui.Review.PreviewAction]}"/>
                                <ScrollViewer Grid.Row="1" Background="{StaticResource WtMantle}">
                                    <StackPanel Padding="12" Spacing="10">
                                        <TextBlock Style="{StaticResource WtTerminalText}" TextWrapping="Wrap"
                                                   Text="{Binding Review.PreviewText}"/>
                                        <Button Style="{StaticResource WtButton}"
                                                Content="{Binding Strings[Gui.Review.PreviewAction]}"
                                                IsEnabled="{Binding Review.CanPreview}"
                                                Click="Preview_Click"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <!-- Result table: the engine's own verdicts, one row per applied
                             change. It appears only after an apply/preview produced rows. -->
                        <Grid Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed"
                              x:Name="ReviewResultsPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource WtPanelTitle}"
                                       Text="{Binding Strings[Gui.Result.Title]}"/>
                            <ListView Grid.Row="1" Background="{StaticResource WtMantle}"
                                      MaxHeight="220" SelectionMode="None"
                                      ItemsSource="{Binding Review.Results}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource WtTerminalText}" Text="{Binding RequestedId}"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource WtTerminalText}" Text="{Binding Status}"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource WtTerminalText}" Text="{Binding Outcome}"/>
                                            <TextBlock Grid.Column="3" Style="{StaticResource WtMutedText}"
                                                       Text="{Binding VerifiedMark}" Foreground="{StaticResource WtGreen}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Style="{StaticResource WtCheckBox}"
                                  Content="{Binding Strings[Gui.DryRun]}" IsChecked="{Binding Review.DryRun, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource WtButton}" Margin="8,0,0,0"
                                Content="{Binding Strings[Gui.Action.ClearPending]}"
                                IsEnabled="{Binding Review.CanClear}" Click="ClearPending_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource WtButton}" Margin="8,0,0,0"
                                Content="{Binding Strings[Gui.Review.RemoveSelected]}"
                                IsEnabled="{Binding Review.CanRemove}" Click="RemovePending_Click"/>
                        <Button Grid.Column="3" Style="{StaticResource WtAccentButton}" Margin="8,0,0,0"
                                Content="{Binding Strings[Gui.Review.ApplyAction]}"
                                IsEnabled="{Binding Review.CanApply}" Click="Apply_Click"/>
                    </Grid>
                </Grid>

                <!-- History. -->
                <Grid x:Name="HistoryPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="{StaticResource WtInnerGap}" Margin="0,0,0,8">
                        <RadioButton x:Name="HistoryModeRadio" IsChecked="True" Click="HistoryMode_Changed"
                                     Content="{Binding Strings[Gui.History]}"/>
                        <RadioButton x:Name="JournalModeRadio" Click="HistoryMode_Changed"
                                     Content="{Binding Strings[Gui.Column.Operation]}"/>
                        <RadioButton x:Name="InterruptedModeRadio" Click="HistoryMode_Changed"
                                     Content="{Binding Strings[Gui.Overview.Interrupted]}"/>
                    </StackPanel>

                    <!--
                        One real table per mode: a shared outer border, a header strip with
                        vertical column separators, and rows with the identical column
                        definitions (1 px separator columns included), so a value can never
                        drift away from its header. The header reserves the scrollbar width
                        on its right edge so columns stay aligned whether or not the list
                        scrolls.
                    -->
                    <Grid Grid.Row="1">
                        <Grid x:Name="HistoryMode">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource WtSurface1}" BorderThickness="1,1,1,1">
                                <Grid Padding="8,6,20,6" Background="{StaticResource WtSurface0}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource WtColumnHeader}" Text="{Binding Strings[Gui.Column.Time]}"/>
                                    <Border Grid.Column="1" Background="{StaticResource WtSurface1}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource WtColumnHeader}" Text="{Binding Strings[Gui.Column.Tweak]}"/>
                                    <Border Grid.Column="3" Background="{StaticResource WtSurface1}"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource WtColumnHeader}" Text="{Binding Strings[Gui.Column.State]}"/>
                                    <Border Grid.Column="5" Background="{StaticResource WtSurface1}"/>
                                    <TextBlock Grid.Column="6" Style="{StaticResource WtColumnHeader}" Text="{Binding Strings[Gui.Column.Result]}"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" BorderBrush="{StaticResource WtSurface1}" BorderThickness="1,0,1,1">
                                <ListView x:Name="HistoryList" Background="{StaticResource WtMantle}"
                                          SelectionMode="Single" ItemsSource="{Binding History.Rows}"
                                          SelectedItem="{Binding History.SelectedRow, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8,6" MinHeight="26" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="1"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="1"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="1"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource WtMutedText}" Text="{Binding Time}"/>
                                                <Border Grid.Column="1" Background="{StaticResource WtSurface1}"/>
                                                <TextBlock Grid.Column="2" Style="{StaticResource WtTerminalText}"
                                                           TextTrimming="CharacterEllipsis" Text="{Binding TweakId}"
                                                           ToolTipService.ToolTip="{Binding TweakId}"/>
                                                <Border Grid.Column="3" Background="{StaticResource WtSurface1}"/>
                                                <TextBlock Grid.Column="4" Style="{StaticResource WtTerminalText}" Text="{Binding State}"/>
                                                <Border Grid.Column="5" Background="{StaticResource WtSurface1}"/>
                                                <!-- Only the outcome carries a colour, and the
                                                     configuration state next to it stays neutral. -->
                                                <TextBlock Grid.Column="6" Style="{StaticResource WtTerminalText}"
                                                           Foreground="{Binding OutcomeTone, Converter={StaticResource WtToneToBrush}}"
                                                           Text="{Binding OutcomeText}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>

                        <Grid x:Name="JournalMode" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource WtSurface1}" BorderThickness="1,1,1,1">
                                <Grid Padding="8,6,20,6" Background="{StaticResource WtSurface0}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource WtColumnHeader}" Text="{Binding Strings[Gui.Column.Time]}"/>
                                    <Border Grid.Column="1" Background="{StaticResource WtSurface1}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource WtColumnHeader}" Text="{Binding Strings[Gui.Column.Tweak]}"/>
                                    <Border Grid.Column="3" Background="{StaticResource WtSurface1}"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource WtColumnHeader}" Text="{Binding Strings[Gui.Column.State]}"/>
                                    <Border Grid.Column="5" Background="{StaticResource WtSurface1}"/>
                                    <TextBlock Grid.Column="6" Style="{StaticResource WtColumnHeader}" Text="{Binding Strings[Gui.Column.Outcome]}"/>
                                    <Border Grid.Column="7" Background="{StaticResource WtSurface1}"/>
                                    <TextBlock Grid.Column="8" Style="{StaticResource WtColumnHeader}" Text="{Binding Strings[Gui.Column.Source]}"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" BorderBrush="{StaticResource WtSurface1}" BorderThickness="1,0,1,1">
                                <ListView x:Name="JournalList" Background="{StaticResource WtMantle}"
                                          SelectionMode="Single" ItemsSource="{Binding History.Operations}"
                                          SelectedItem="{Binding History.SelectedOperation, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8,6" MinHeight="26" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="1"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="1"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="1"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="1"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource WtMutedText}" Text="{Binding Time}"/>
                                                <Border Grid.Column="1" Background="{StaticResource WtSurface1}"/>
                                                <TextBlock Grid.Column="2" Style="{StaticResource WtTerminalText}"
                                                           TextTrimming="CharacterEllipsis" Text="{Binding TweakId}"
                                                           ToolTipService.ToolTip="{Binding TweakId}"/>
                                                <Border Grid.Column="3" Background="{StaticResource WtSurface1}"/>
                                                <TextBlock Grid.Column="4" Style="{StaticResource WtTerminalText}" Text="{Binding Stage}"/>
                                                <Border Grid.Column="5" Background="{StaticResource WtSurface1}"/>
                                                <TextBlock Grid.Column="6" Style="{StaticResource WtTerminalText}" Text="{Binding Outcome}"/>
                                                <Border Grid.Column="7" Background="{StaticResource WtSurface1}"/>
                                                <TextBlock Grid.Column="8" Style="{StaticResource WtMutedText}" Text="{Binding Origin}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>

                        <Grid x:Name="InterruptedMode" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource WtSurface1}" BorderThickness="1,1,1,1">
                                <Grid Padding="8,6,20,6" Background="{StaticResource WtSurface0}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource WtColumnHeader}" Text="{Binding Strings[Gui.Column.Time]}"/>
                                    <Border Grid.Column="1" Background="{StaticResource WtSurface1}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource WtColumnHeader}" Text="{Binding Strings[Gui.Column.Tweak]}"/>
                                    <Border Grid.Column="3" Background="{StaticResource WtSurface1}"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource WtColumnHeader}" Text="{Binding Strings[Gui.Column.State]}"/>
                                    <Border Grid.Column="5" Background="{StaticResource WtSurface1}"/>
                                    <TextBlock Grid.Column="6" Style="{StaticResource WtColumnHeader}" Text="{Binding Strings[Gui.Action.Restore]}"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" BorderBrush="{StaticResource WtSurface1}" BorderThickness="1,0,1,1">
                                <ListView x:Name="InterruptedList" Background="{StaticResource WtMantle}"
                                          SelectionMode="Single" ItemsSource="{Binding History.Interrupted}"
                                          SelectedItem="{Binding History.SelectedInterrupted, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8,6" MinHeight="26" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="1"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="1"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="1"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource WtMutedText}" Text="{Binding Time}"/>
                                                <Border Grid.Column="1" Background="{StaticResource WtSurface1}"/>
                                                <TextBlock Grid.Column="2" Style="{StaticResource WtTerminalText}"
                                                           TextTrimming="CharacterEllipsis" Text="{Binding TweakId}"
                                                           ToolTipService.ToolTip="{Binding TweakId}"/>
                                                <Border Grid.Column="3" Background="{StaticResource WtSurface1}"/>
                                                <TextBlock Grid.Column="4" Style="{StaticResource WtTerminalText}" Text="{Binding Stage}"/>
                                                <Border Grid.Column="5" Background="{StaticResource WtSurface1}"/>
                                                <TextBlock Grid.Column="6" Style="{StaticResource WtTerminalText}" Text="{Binding CanRestoreLabel}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Selected-row details: a panel with its own padding, so the summary and
                         the raw detail wrap and breathe inside the border. -->
                    <Border Grid.Row="2" Style="{StaticResource WtPanel}" Margin="0,12,0,0">
                        <Grid Padding="{StaticResource WtPanelPadding}" ColumnSpacing="{StaticResource WtInnerGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="{StaticResource WtInnerGap}">
                                <TextBlock Style="{StaticResource WtSectionTitle}" Margin="0"
                                           Text="{Binding Strings[Gui.History.Selected]}"/>
                                <TextBlock Style="{StaticResource WtTerminalText}" TextWrapping="Wrap"
                                           Text="{Binding History.SelectedSummary}"/>
                                <TextBlock Style="{StaticResource WtMutedText}"
                                           Text="{Binding Strings[Gui.History.NoSelection]}"
                                           Visibility="{Binding History.HasSelection, Converter={StaticResource WtBoolToCollapsed}}"/>
                                <StackPanel Spacing="{StaticResource WtInnerGap}">
                                    <Button x:Name="HistoryDetailButton" Style="{StaticResource WtButton}"
                                            HorizontalAlignment="Left"
                                            Content="{Binding Strings[Gui.Diagnostics.Raw]}"
                                            Click="HistoryDetail_Click"/>
                                    <TextBox x:Name="HistoryDetailBox" Style="{StaticResource WtTextBox}"
                                             Padding="{StaticResource WtLogPadding}" IsReadOnly="True"
                                             TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="120" Visibility="Collapsed"
                                             Text="{Binding History.SelectedRaw, Mode=OneWay}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource WtAccentButton}" VerticalAlignment="Top"
                                    Content="{Binding Strings[Gui.Action.Restore]}"
                                    IsEnabled="{Binding History.CanRestore}" Click="Restore_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Diagnostics. -->
                <ScrollViewer x:Name="DiagnosticsPanel" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel Spacing="{StaticResource WtPanelGap}" Padding="0,0,12,12">

                        <!-- Summary: environment, runtime and connection facts. -->
                        <Border Style="{StaticResource WtPanel}">
                            <StackPanel Padding="{StaticResource WtPanelPadding}" Spacing="{StaticResource WtInnerGap}">
                                <TextBlock Style="{StaticResource WtPanelTitle}" Margin="0"
                                           Text="{Binding Strings[Gui.Diagnostics.Summary]}"/>
                                <Grid ColumnSpacing="10" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource WtMutedText}" Text="{Binding Strings[Gui.Overview.Os]}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource WtTerminalText}" TextWrapping="Wrap" Text="{Binding Diagnostics.SummaryOs}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource WtMutedText}" Text="{Binding Strings[Gui.Overview.PowerShell]}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource WtTerminalText}" TextWrapping="Wrap" Text="{Binding Diagnostics.SummaryPowerShell}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource WtMutedText}" Text="{Binding Strings[Gui.Overview.Privilege]}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource WtTerminalText}" TextWrapping="Wrap" Text="{Binding Diagnostics.SummaryPrivilege}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource WtMutedText}" Text="{Binding Strings[Gui.Overview.Engine]}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource WtTerminalText}" TextWrapping="Wrap" Text="{Binding Diagnostics.SummaryEngine}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource WtMutedText}" Text="{Binding Strings[Gui.Header.Backend]}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource WtTerminalText}" TextWrapping="Wrap" Text="{Binding Diagnostics.SummaryBackend}"/>
                                </Grid>

                                <!-- The long property dump lives here, collapsed by default, in a
                                     selectable box with a copy action. -->
                                <StackPanel Spacing="{StaticResource WtInnerGap}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource WtInnerGap}">
                                        <Button Style="{StaticResource WtButton}" MinHeight="32"
                                                Content="{Binding Strings[Gui.Diagnostics.TechnicalDetails]}"
                                                Click="DiagnosticsTechnicalDetails_Click"/>
                                        <Button Style="{StaticResource WtButton}" MinHeight="32"
                                                Content="{Binding Diagnostics.TechnicalDetailsCopyText}"
                                                Click="DiagnosticsCopyTechnical_Click"
                                                ToolTipService.ToolTip="{Binding Strings[Gui.Diagnostics.Copy]}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="TechnicalDetailsPanel" Spacing="{StaticResource WtInnerGap}" Visibility="Collapsed">
                                        <ItemsControl ItemsSource="{Binding Diagnostics.EnvironmentFacts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{StaticResource WtTerminalText}" TextWrapping="Wrap" Text="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox x:Name="TechnicalDetailsBox" Style="{StaticResource WtTextBox}"
                                                 Padding="{StaticResource WtLogPadding}" IsReadOnly="True"
                                                 TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="220"
                                                 Text="{Binding Diagnostics.TechnicalDetailsText, Mode=OneWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Report: the generated diagnostics report. The status pill carries
                             the section's own state (not loaded / loading / ready / error) so a
                             section in flight never shows a stale summary. -->
                        <Border Style="{StaticResource WtPanel}">
                            <StackPanel Padding="{StaticResource WtPanelPadding}" Spacing="{StaticResource WtInnerGap}">
                                <TextBlock Style="{StaticResource WtPanelTitle}" Margin="0" Text="{Binding Strings[Gui.Diagnostics.Report]}"/>
                                <TextBlock Style="{StaticResource WtTerminalText}" TextWrapping="Wrap"
                                           Text="{Binding Diagnostics.ReportSummary}"
                                           Visibility="{Binding Diagnostics.ReportSummaryVisible, Converter={StaticResource WtBoolToVisible}}"/>
                                <Border Style="{StaticResource WtBadge}"
                                        BorderBrush="{Binding Diagnostics.ReportStatusTone, Converter={StaticResource WtToneToBrush}}">
                                    <TextBlock Style="{StaticResource WtTerminalText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{Binding Diagnostics.ReportStatusTone, Converter={StaticResource WtToneToBrush}}"
                                               Text="{Binding Diagnostics.ReportStatusText}"/>
                                </Border>
                                <StackPanel Spacing="{StaticResource WtInnerGap}">
                                    <!-- The primary action of the section is blue; the
                                         detail toggle is a secondary action. -->
                                    <Button Style="{StaticResource WtAccentButton}" HorizontalAlignment="Left" MinHeight="32"
                                            IsEnabled="{Binding IsConnected}"
                                            Content="{Binding Diagnostics.ReportActionText}" Click="DiagnosticsSection_Click" Tag="report"/>
                                    <Button Style="{StaticResource WtButton}" HorizontalAlignment="Left" MinHeight="32"
                                            Content="{Binding Strings[Gui.Diagnostics.Raw]}" Click="ReportDetail_Click"/>
                                    <TextBox x:Name="ReportDetailBox" Style="{StaticResource WtTextBox}"
                                             Padding="{StaticResource WtLogPadding}" IsReadOnly="True"
                                             TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="150" Visibility="Collapsed"
                                             Text="{Binding Diagnostics.ReportRaw, Mode=OneWay}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Scan: path input plus the run action. -->
                        <Border Style="{StaticResource WtPanel}">
                            <StackPanel Padding="{StaticResource WtPanelPadding}" Spacing="{StaticResource WtInnerGap}">
                                <TextBlock Style="{StaticResource WtPanelTitle}" Margin="0" Text="{Binding Strings[Gui.Diagnostics.Scan]}"/>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource WtInnerGap}">
                                    <TextBox Style="{StaticResource WtTextBox}" MinWidth="300"
                                             AutomationProperties.Name="{Binding Strings[Gui.Diagnostics.ScanPath]}"
                                             PlaceholderText="{Binding Strings[Gui.Diagnostics.ScanPath]}"
                                             Text="{Binding Diagnostics.ScanPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Style="{StaticResource WtAccentButton}" MinHeight="32" IsEnabled="{Binding IsConnected}"
                                            Content="{Binding Diagnostics.ScanActionText}" Click="DiagnosticsSection_Click" Tag="scan"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource WtTerminalText}" TextWrapping="Wrap"
                                           Text="{Binding Diagnostics.ScanSummary}"
                                           Visibility="{Binding Diagnostics.ScanSummaryVisible, Converter={StaticResource WtBoolToVisible}}"/>
                                <Border Style="{StaticResource WtBadge}"
                                        BorderBrush="{Binding Diagnostics.ScanStatusTone, Converter={StaticResource WtToneToBrush}}">
                                    <TextBlock Style="{StaticResource WtTerminalText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{Binding Diagnostics.ScanStatusTone, Converter={StaticResource WtToneToBrush}}"
                                               Text="{Binding Diagnostics.ScanStatusText}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Monitor: one read-only cycle. -->
                        <Border Style="{StaticResource WtPanel}">
                            <StackPanel Padding="{StaticResource WtPanelPadding}" Spacing="{StaticResource WtInnerGap}">
                                <TextBlock Style="{StaticResource WtPanelTitle}" Margin="0" Text="{Binding Strings[Gui.Diagnostics.Monitor]}"/>
                                <Button Style="{StaticResource WtAccentButton}" HorizontalAlignment="Left" MinHeight="32"
                                        IsEnabled="{Binding IsConnected}"
                                        Content="{Binding Strings[Gui.Diagnostics.MonitorRun]}" Click="DiagnosticsSection_Click" Tag="monitor"/>
                                <TextBlock Style="{StaticResource WtTerminalText}" TextWrapping="Wrap"
                                           Text="{Binding Diagnostics.MonitorSummary}"
                                           Visibility="{Binding Diagnostics.MonitorSummaryVisible, Converter={StaticResource WtBoolToVisible}}"/>
                                <Border Style="{StaticResource WtBadge}"
                                        BorderBrush="{Binding Diagnostics.MonitorStatusTone, Converter={StaticResource WtToneToBrush}}">
                                    <TextBlock Style="{StaticResource WtTerminalText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{Binding Diagnostics.MonitorStatusTone, Converter={StaticResource WtToneToBrush}}"
                                               Text="{Binding Diagnostics.MonitorStatusText}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Devices. -->
                        <Border Style="{StaticResource WtPanel}">
                            <StackPanel Padding="{StaticResource WtPanelPadding}" Spacing="{StaticResource WtInnerGap}">
                                <TextBlock Style="{StaticResource WtPanelTitle}" Margin="0" Text="{Binding Strings[Gui.Diagnostics.Devices]}"/>
                                <Button Style="{StaticResource WtButton}" HorizontalAlignment="Left" MinHeight="32"
                                        IsEnabled="{Binding IsConnected}"
                                        Content="{Binding Strings[Gui.Diagnostics.Run]}" Click="DiagnosticsSection_Click" Tag="devices"/>
                                <TextBlock Style="{StaticResource WtTerminalText}" TextWrapping="Wrap"
                                           Text="{Binding Diagnostics.DeviceSummary}"
                                           Visibility="{Binding Diagnostics.DeviceSummaryVisible, Converter={StaticResource WtBoolToVisible}}"/>
                                <Border Style="{StaticResource WtBadge}"
                                        BorderBrush="{Binding Diagnostics.DeviceStatusTone, Converter={StaticResource WtToneToBrush}}">
                                    <TextBlock Style="{StaticResource WtTerminalText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{Binding Diagnostics.DeviceStatusTone, Converter={StaticResource WtToneToBrush}}"
                                               Text="{Binding Diagnostics.DeviceStatusText}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Power. -->
                        <Border Style="{StaticResource WtPanel}">
                            <StackPanel Padding="{StaticResource WtPanelPadding}" Spacing="{StaticResource WtInnerGap}">
                                <TextBlock Style="{StaticResource WtPanelTitle}" Margin="0" Text="{Binding Strings[Gui.Diagnostics.Power]}"/>
                                <Button Style="{StaticResource WtButton}" HorizontalAlignment="Left" MinHeight="32"
                                        IsEnabled="{Binding IsConnected}"
                                        Content="{Binding Strings[Gui.Diagnostics.Run]}" Click="DiagnosticsSection_Click" Tag="power"/>
                                <TextBlock Style="{StaticResource WtTerminalText}" TextWrapping="Wrap"
                                           Text="{Binding Diagnostics.PowerSummary}"
                                           Visibility="{Binding Diagnostics.PowerSummaryVisible, Converter={StaticResource WtBoolToVisible}}"/>
                                <Border Style="{StaticResource WtBadge}"
                                        BorderBrush="{Binding Diagnostics.PowerStatusTone, Converter={StaticResource WtToneToBrush}}">
                                    <TextBlock Style="{StaticResource WtTerminalText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{Binding Diagnostics.PowerStatusTone, Converter={StaticResource WtToneToBrush}}"
                                               Text="{Binding Diagnostics.PowerStatusText}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Privacy. -->
                        <Border Style="{StaticResource WtPanel}">
                            <StackPanel Padding="{StaticResource WtPanelPadding}" Spacing="{StaticResource WtInnerGap}">
                                <TextBlock Style="{StaticResource WtPanelTitle}" Margin="0" Text="{Binding Strings[Gui.Diagnostics.Privacy]}"/>
                                <Button Style="{StaticResource WtButton}" HorizontalAlignment="Left" MinHeight="32"
                                        IsEnabled="{Binding IsConnected}"
                                        Content="{Binding Strings[Gui.Diagnostics.Run]}" Click="DiagnosticsSection_Click" Tag="privacy"/>
                                <TextBlock Style="{StaticResource WtTerminalText}" TextWrapping="Wrap"
                                           Text="{Binding Diagnostics.PrivacySummary}"
                                           Visibility="{Binding Diagnostics.PrivacySummaryVisible, Converter={StaticResource WtBoolToVisible}}"/>
                                <Border Style="{StaticResource WtBadge}"
                                        BorderBrush="{Binding Diagnostics.PrivacyStatusTone, Converter={StaticResource WtToneToBrush}}">
                                    <TextBlock Style="{StaticResource WtTerminalText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{Binding Diagnostics.PrivacyStatusTone, Converter={StaticResource WtToneToBrush}}"
                                               Text="{Binding Diagnostics.PrivacyStatusText}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Quarantine. -->
                        <Border Style="{StaticResource WtPanel}">
                            <StackPanel Padding="{StaticResource WtPanelPadding}" Spacing="{StaticResource WtInnerGap}">
                                <TextBlock Style="{StaticResource WtPanelTitle}" Margin="0" Text="{Binding Strings[Gui.Diagnostics.Quarantine]}"/>
                                <Button Style="{StaticResource WtButton}" HorizontalAlignment="Left" MinHeight="32"
                                        IsEnabled="{Binding IsConnected}"
                                        Content="{Binding Strings[Gui.Diagnostics.Run]}" Click="DiagnosticsSection_Click" Tag="quarantine"/>
                                <TextBlock Style="{StaticResource WtTerminalText}" TextWrapping="Wrap"
                                           Text="{Binding Diagnostics.QuarantineSummary}"
                                           Visibility="{Binding Diagnostics.QuarantineSummaryVisible, Converter={StaticResource WtBoolToVisible}}"/>
                                <Border Style="{StaticResource WtBadge}"
                                        BorderBrush="{Binding Diagnostics.QuarantineStatusTone, Converter={StaticResource WtToneToBrush}}">
                                    <TextBlock Style="{StaticResource WtTerminalText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{Binding Diagnostics.QuarantineStatusTone, Converter={StaticResource WtToneToBrush}}"
                                               Text="{Binding Diagnostics.QuarantineStatusText}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Setup plans. -->
                        <Border Style="{StaticResource WtPanel}">
                            <StackPanel Padding="{StaticResource WtPanelPadding}" Spacing="{StaticResource WtInnerGap}">
                                <TextBlock Style="{StaticResource WtPanelTitle}" Margin="0" Text="{Binding Strings[Gui.Diagnostics.SetupPlans]}"/>
                                <Button Style="{StaticResource WtButton}" HorizontalAlignment="Left" MinHeight="32"
                                        IsEnabled="{Binding IsConnected}"
                                        Content="{Binding Strings[Gui.Diagnostics.Run]}" Click="DiagnosticsSection_Click" Tag="setup"/>
                                <TextBlock Style="{StaticResource WtTerminalText}" TextWrapping="Wrap"
                                           Text="{Binding Diagnostics.SetupSummary}"
                                           Visibility="{Binding Diagnostics.SetupSummaryVisible, Converter={StaticResource WtBoolToVisible}}"/>
                                <Border Style="{StaticResource WtBadge}"
                                        BorderBrush="{Binding Diagnostics.SetupStatusTone, Converter={StaticResource WtToneToBrush}}">
                                    <TextBlock Style="{StaticResource WtTerminalText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{Binding Diagnostics.SetupStatusTone, Converter={StaticResource WtToneToBrush}}"
                                               Text="{Binding Diagnostics.SetupStatusText}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Backend activity log: bounded, scrollable, selectable, copyable. -->
                        <Border Style="{StaticResource WtPanel}">
                            <StackPanel Padding="{StaticResource WtPanelPadding}" Spacing="{StaticResource WtInnerGap}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource WtPanelTitle}" Margin="0"
                                               VerticalAlignment="Center" Text="{Binding Strings[Gui.Busy.Title]}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource WtMutedText}" VerticalAlignment="Center"
                                               Margin="0,0,8,0" Text="{Binding Diagnostics.CountText}"/>
                                    <Button Grid.Column="2" x:Name="DiagnosticsLogCopyButton" Style="{StaticResource WtButton}"
                                            MinHeight="32" VerticalAlignment="Center"
                                            Content="{Binding Diagnostics.LogCopyText}" Click="DiagnosticsLogCopy_Click"
                                            ToolTipService.ToolTip="{Binding Strings[Gui.Diagnostics.Copy]}"/>
                                </Grid>
                                <TextBox x:Name="DiagnosticsLogBox" Style="{StaticResource WtTextBox}"
                                         Padding="{StaticResource WtLogPadding}"
                                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="220"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Text="{Binding Diagnostics.DiagnosticsText, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Licensing. -->
                <Grid x:Name="LicensingPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,12,0">
                        <!--
                            The Windows licensing state is the most prominent fact here: a
                            badge whose colour says verified / unknown / error, driven only by
                            the read-only licensing query. The external tool's readiness and
                            the selected method's advertised duration are separate facts
                            below it - choosing a "Permanent" method never turns this badge
                            green, because only Windows can say that.
                        -->
                        <Border Style="{StaticResource WtPanel}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource WtPanelTitle}" Text="{Binding Licensing.LicenseStateTitle}"/>
                                <Border Style="{StaticResource WtPanel}" Margin="10,0,10,8" Padding="10,8"
                                        HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource WtTerminalText}" FontSize="18" TextWrapping="Wrap"
                                               Foreground="{Binding Licensing.LicenseBadgeTone, Converter={StaticResource WtToneToBrush}}"
                                               Text="{Binding Licensing.LicenseBadgeText}"/>
                                </Border>
                                <TextBlock Style="{StaticResource WtTerminalText}" TextWrapping="Wrap" Margin="10,0,10,4"
                                           Text="{Binding Licensing.LicensingStatus}"/>
                                <TextBlock Style="{StaticResource WtMutedText}" Margin="10,0,10,4"
                                           Text="{Binding Licensing.EditionText}"/>
                                <TextBlock Style="{StaticResource WtMutedText}" Margin="10,0,10,10"
                                           Text="{Binding Licensing.StatusText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource WtPanel}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource WtPanelTitle}" Text="{Binding Strings[Gui.Licensing.Method]}"/>
                                <ListView x:Name="MethodList" SelectionMode="Single" Background="Transparent"
                                          ItemsSource="{Binding Licensing.Methods}"
                                          SelectedItem="{Binding Licensing.SelectedMethod, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource WtTerminalText}" Text="{Binding Id}" Padding="4,4"/>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel Margin="10,6,10,10" Spacing="2">
                                    <TextBlock Style="{StaticResource WtMutedText}" Text="{Binding Licensing.MethodDurationTitle}"/>
                                    <TextBlock Style="{StaticResource WtTerminalText}" TextWrapping="Wrap"
                                               Text="{Binding Licensing.MethodDurationText}"/>
                                    <TextBlock Style="{StaticResource WtMutedText}" TextWrapping="Wrap"
                                               Text="{Binding Licensing.MethodDetail}"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,10,10" Spacing="2">
                                    <TextBlock Style="{StaticResource WtMutedText}" Text="{Binding Licensing.ToolSectionTitle}"/>
                                    <TextBlock Style="{StaticResource WtTerminalText}" TextWrapping="Wrap"
                                               Text="{Binding Licensing.ToolStatusText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{StaticResource WtSurface1}"/>

                    <StackPanel Grid.Column="2" Spacing="10" Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource WtMutedText}" TextWrapping="Wrap" Text="{Binding Strings[Gui.Licensing.Separate]}"/>
                        <Button Style="{StaticResource WtButton}" Content="{Binding Strings[Gui.Licensing.Download]}"
                                IsEnabled="{Binding Licensing.CanDownload}" Click="DownloadTool_Click"/>
                        <Button Style="{StaticResource WtButton}" Content="{Binding Strings[Gui.Licensing.Remove]}"
                                IsEnabled="{Binding Licensing.CanRemove}" Click="RemoveTool_Click"/>
                        <Button Style="{StaticResource WtDangerButton}" Content="{Binding Strings[Gui.Licensing.Activate]}"
                                IsEnabled="{Binding Licensing.CanActivate}" Click="Activate_Click"/>
                        <Button Style="{StaticResource WtButton}" Content="{Binding Strings[Gui.Licensing.Slmgr]}"
                                IsEnabled="{Binding Licensing.CanRequestSlmgr}" Click="Slmgr_Click"/>
                        <TextBlock Style="{StaticResource WtTerminalText}" TextWrapping="Wrap" Text="{Binding Licensing.LastOutcome}"/>
                        <TextBlock Style="{StaticResource WtMutedText}" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Licensing.ToolStatusText}"/>
                    </StackPanel>
                </Grid>

                <!-- Result strip: what the current workspace is doing, once. -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource WtMutedText}" TextWrapping="Wrap"
                               Text="{Binding ProgressText}"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status bar: one status line, plus the key hints. -->
        <Grid Grid.Row="3" Background="{StaticResource WtMantle}" Padding="12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!--
                The footer describes the activity, not the connectivity: while something is
                in flight it names the work ("loading the tweak list..."), and the header
                pill is what says "connected". Idle falls back to the idle label.
            -->
            <TextBlock Grid.Column="0" Style="{StaticResource WtMutedText}" TextWrapping="Wrap"
                       Text="{Binding FooterStatusText}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource WtMutedText}"
                       Text="{Binding Strings[Gui.Footer.Hint]}" Margin="12,0,0,0"/>
        </Grid>
    </Grid>
</Window>
