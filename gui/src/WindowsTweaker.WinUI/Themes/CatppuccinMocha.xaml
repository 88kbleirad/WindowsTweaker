<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Catppuccin Mocha, as the terminal interface uses it (src/.../Private/Tui/Theme.ps1). -->
    <SolidColorBrush x:Key="WtBase" Color="#1e1e2e"/>
    <SolidColorBrush x:Key="WtMantle" Color="#181825"/>
    <SolidColorBrush x:Key="WtCrust" Color="#11111b"/>
    <SolidColorBrush x:Key="WtSurface0" Color="#313244"/>
    <SolidColorBrush x:Key="WtSurface1" Color="#45475a"/>
    <SolidColorBrush x:Key="WtSurface2" Color="#585b70"/>
    <SolidColorBrush x:Key="WtOverlay0" Color="#6c7086"/>
    <SolidColorBrush x:Key="WtText" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="WtSubtext" Color="#a6adc8"/>
    <SolidColorBrush x:Key="WtBlue" Color="#89b4fa"/>
    <SolidColorBrush x:Key="WtGreen" Color="#a6e3a1"/>
    <SolidColorBrush x:Key="WtYellow" Color="#f9e2af"/>
    <SolidColorBrush x:Key="WtRed" Color="#f38ba8"/>
    <SolidColorBrush x:Key="WtMauve" Color="#cba6f7"/>
    <SolidColorBrush x:Key="WtPeach" Color="#fab387"/>
    <SolidColorBrush x:Key="WtSky" Color="#89dceb"/>
    <SolidColorBrush x:Key="WtSapphire" Color="#74c7ec"/>
    <SolidColorBrush x:Key="WtTeal" Color="#94e2d5"/>

    <Style x:Key="WtPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WtMantle}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WtSurface1}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- Square corners: the TUI look has no rounded edges on app-owned surfaces. -->
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style x:Key="WtPanelTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WtBlue}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="10,10,10,6"/>
    </Style>

    <Style x:Key="WtBodyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WtText}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="WtMutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WtSubtext}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="WtTerminalText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WtText}"/>
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="WtButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource WtSurface0}"/>
        <Setter Property="Foreground" Value="{StaticResource WtText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WtSurface2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="WtAccentButton" TargetType="Button" BasedOn="{StaticResource WtButton}">
        <Setter Property="Background" Value="{StaticResource WtBlue}"/>
        <Setter Property="Foreground" Value="{StaticResource WtCrust}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WtBlue}"/>
    </Style>

    <Style x:Key="WtDangerButton" TargetType="Button" BasedOn="{StaticResource WtButton}">
        <Setter Property="Background" Value="{StaticResource WtRed}"/>
        <Setter Property="Foreground" Value="{StaticResource WtCrust}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WtRed}"/>
    </Style>

    <Style x:Key="WtTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource WtCrust}"/>
        <Setter Property="Foreground" Value="{StaticResource WtText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WtSurface1}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="WtComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource WtMantle}"/>
        <Setter Property="Foreground" Value="{StaticResource WtText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WtSurface1}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="WtCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource WtText}"/>
    </Style>

    <!-- Status badge: text + color, never color alone. -->
    <Style x:Key="WtBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WtSurface0}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WtSurface2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>

    <!-- The header's connection/privilege pills: compact, square, bordered. -->
    <Style x:Key="WtStatusPill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WtSurface0}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WtSurface1}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>

    <!-- Section headings inside a workspace pane (Categories / Tweaks / Details ...). -->
    <Style x:Key="WtSectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WtSubtext}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- Table column headings (the History lists). -->
    <Style x:Key="WtColumnHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WtSubtext}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="WtBadgeOk" TargetType="Border" BasedOn="{StaticResource WtBadge}">
        <Setter Property="BorderBrush" Value="{StaticResource WtGreen}"/>
    </Style>

    <Style x:Key="WtBadgeWarn" TargetType="Border" BasedOn="{StaticResource WtBadge}">
        <Setter Property="BorderBrush" Value="{StaticResource WtYellow}"/>
    </Style>

    <Style x:Key="WtBadgeError" TargetType="Border" BasedOn="{StaticResource WtBadge}">
        <Setter Property="BorderBrush" Value="{StaticResource WtRed}"/>
    </Style>

    <!--
    ==================================================================================
    Control theming
    ==================================================================================
    Two layers, both required for a consistent Catppuccin Mocha look that matches the
    terminal interface:

      1. Global shape and typography. WinUI derives most control geometry from theme
         resources, so overriding ControlCornerRadius / OverlayCornerRadius squares every
         app-owned control at once (the TUI has no rounded edges), and an implicit
         TextBlock style gives every label the same monospace face.

      2. Per-state brushes. The default templates read their hover / pressed / selected /
         disabled colours from theme-dictionary brushes, which would otherwise paint
         Windows blue over a Mocha surface. Overriding those keys by name is the supported
         way to restyle them without replacing a single ControlTemplate, so focus visuals,
         keyboard interaction and accessibility behaviour stay exactly as WinUI ships them.

    Every key below was verified to exist (with a compatible type) in the pinned Windows
    App SDK 1.8 generic.xaml; square corners and thin borders are intentional.
    -->

    <!-- Global shape: square app-owned controls. -->
    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ListViewItemCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ListViewItemSelectionIndicatorCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ScrollBarCornerRadius">0</CornerRadius>

    <!-- Compact rows (the TUI packs rows tightly). -->
    <x:Double x:Key="ListViewItemMinHeight">28</x:Double>

    <FontFamily x:Key="WtMonoFont">Cascadia Mono, Consolas, monospace</FontFamily>

    <!--
    Icon face for the few action buttons that carry a glyph. The chain falls back from the
    Windows 11 icon font to the Windows 10 one, and only codepoints present in both fonts are
    used, so a target without Segoe Fluent Icons still draws a real glyph instead of a box.
    -->
    <FontFamily x:Key="WtIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Typography: every label uses the same monospace face unless a keyed style says otherwise. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WtMonoFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource WtText}"/>
    </Style>

    <!-- Lists and navigation: Mocha selection instead of the saturated default accent fill. -->
    <SolidColorBrush x:Key="ListViewItemBackground" Color="#1e1e2e"/>
    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#181825"/>
    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#313244"/>
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#313244"/>
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#45475a"/>
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#45475a"/>
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedDisabled" Color="#181825"/>
    <SolidColorBrush x:Key="ListViewItemForeground" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ListViewItemForegroundPressed" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="#cdd6f4"/>

    <!-- The accent indicator: a thin blue bar, never a filled blue row. -->
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#89b4fa"/>
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#89b4fa"/>
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="#89b4fa"/>
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorDisabledBrush" Color="#45475a"/>

    <!-- Keyboard focus stays clearly visible against every surface. -->
    <SolidColorBrush x:Key="ListViewItemFocusVisualPrimaryBrush" Color="#89b4fa"/>
    <SolidColorBrush x:Key="ListViewItemFocusVisualSecondaryBrush" Color="#11111b"/>
    <SolidColorBrush x:Key="ListViewItemFocusBorderBrush" Color="#89b4fa"/>

    <!-- ComboBox (closed state) and its popup. -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#181825"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#313244"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#313244"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#11111b"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#181825"/>
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#6c7086"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#45475a"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#89b4fa"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#89b4fa"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#313244"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#181825"/>
    <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#45475a"/>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#a6adc8"/>

    <!-- ComboBox popup rows. -->
    <SolidColorBrush x:Key="ComboBoxItemBackground" Color="#181825"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#313244"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#313244"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#313244"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#45475a"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#45475a"/>
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#cdd6f4"/>

    <!-- Buttons: all five visual states, so a styled button never flashes default grey. -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#313244"/>
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#45475a"/>
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#585b70"/>
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#181825"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6c7086"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#585b70"/>
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#89b4fa"/>
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#89b4fa"/>
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#313244"/>

    <!-- Text inputs. -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#11111b"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#11111b"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#11111b"/>
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#181825"/>
    <SolidColorBrush x:Key="TextControlForeground" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#6c7086"/>
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#45475a"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#89b4fa"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#89b4fa"/>
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#313244"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6c7086"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#6c7086"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#a6adc8"/>

    <!-- Check boxes: blue fill when checked, readable label in every state. -->
    <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPressed" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="CheckBoxForegroundUncheckedDisabled" Color="#6c7086"/>
    <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="CheckBoxForegroundCheckedPressed" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="CheckBoxForegroundCheckedDisabled" Color="#6c7086"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#11111b"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#181825"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="#181825"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#89b4fa"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#89b4fa"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#74c7ec"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#585b70"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#89b4fa"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="#89b4fa"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#89b4fa"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#89b4fa"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#74c7ec"/>

    <!-- Radio buttons (the history mode selector). -->
    <SolidColorBrush x:Key="RadioButtonForeground" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="RadioButtonForegroundPointerOver" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="RadioButtonForegroundPressed" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="RadioButtonForegroundDisabled" Color="#6c7086"/>

    <!-- Scrollbars: thin, Mocha, never the default OS chrome. -->
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#585b70"/>
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#6c7086"/>
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#a6adc8"/>
    <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="#313244"/>
    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#181825"/>
    <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="#313244"/>

    <!-- Dialogs: square, Mocha, readable. -->
    <SolidColorBrush x:Key="ContentDialogBackground" Color="#1e1e2e"/>
    <SolidColorBrush x:Key="ContentDialogForeground" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#45475a"/>

    <!-- Tooltips: square, Mocha. -->
    <SolidColorBrush x:Key="ToolTipBackground" Color="#181825"/>
    <SolidColorBrush x:Key="ToolTipForeground" Color="#cdd6f4"/>
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#45475a"/>
</ResourceDictionary>
