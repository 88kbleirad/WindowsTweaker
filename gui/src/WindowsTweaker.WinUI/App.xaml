<Application
    x:Class="WindowsTweaker.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsTweaker.WinUI"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <!-- State visibility (loading / empty / failed / ready) without code behind. -->
            <local:BoolToVisibilityConverter x:Key="WtBoolToVisible"/>
            <local:BoolToVisibilityConverter x:Key="WtBoolToCollapsed" Invert="True"/>
            <local:PercentToHeightConverter x:Key="WtPercentToHeight"/>
            <local:ToneToBrushConverter x:Key="WtToneToBrush"/>
            <local:PercentToStarLengthConverter x:Key="WtUsedStar"/>
            <local:PercentToStarLengthConverter x:Key="WtFreeStar" Invert="True"/>
            <local:MetricQualityToGaugeConverter x:Key="WtMetricQualityToGauge"/>
            <local:PercentToGaugeStatusConverter x:Key="WtPercentToGaugeStatus"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/CatppuccinMocha.xaml"/>
                <!-- The reusable semicircular gauge control's template. -->
                <ResourceDictionary Source="Themes/GaugeStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
