<!--
  WindowsTweaker - main window.

  Styling only. All behaviour lives in WindowsTweaker.psm1 (see Gui\Gui.ps1), so the
  look of the interface never influences how a change is applied.

  Catppuccin Mocha palette:
    base #1e1e2e  mantle #181825  crust #11111b  surface0 #313244  surface1 #45475a
    text #cdd6f4  subtext #a6adc8  blue #89b4fa  green #a6e3a1  yellow #f9e2af
    red #f38ba8  mauve #cba6f7
  Corners are square by design: no CornerRadius is set anywhere.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowsTweaker"
        Height="820" Width="1280"
        MinHeight="620" MinWidth="1024"
        Background="#1e1e2e"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="Base" Color="#1e1e2e"/>
        <SolidColorBrush x:Key="Mantle" Color="#181825"/>
        <SolidColorBrush x:Key="Crust" Color="#11111b"/>
        <SolidColorBrush x:Key="Surface0" Color="#313244"/>
        <SolidColorBrush x:Key="Surface1" Color="#45475a"/>
        <SolidColorBrush x:Key="Text" Color="#cdd6f4"/>
        <SolidColorBrush x:Key="Subtext" Color="#a6adc8"/>
        <SolidColorBrush x:Key="Blue" Color="#89b4fa"/>
        <SolidColorBrush x:Key="Green" Color="#a6e3a1"/>
        <SolidColorBrush x:Key="Yellow" Color="#f9e2af"/>
        <SolidColorBrush x:Key="Red" Color="#f38ba8"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Subtext}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface0}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Surface1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface1}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Mantle}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Surface1}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Surface0}"/>
            <Setter Property="Foreground" Value="#11111b"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{StaticResource Mantle}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Surface1}"/>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource Surface0}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Surface1}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Mantle}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Surface1}"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Surface0}"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock x:Name="HeaderIcon" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="{StaticResource Blue}" Text="&#xE713;" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock x:Name="HeaderTitle" Text="WindowsTweaker" FontSize="20" Foreground="{StaticResource Blue}"/>
                    <TextBlock x:Name="HeaderSubtitle" Style="{StaticResource MutedText}" Text="Reviewable, reversible Windows customization"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="LblLanguage" Text="Language" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="LanguageCombo" Width="110" Margin="0,0,12,0"/>
                <TextBlock x:Name="EnvText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Text=""/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Background="{StaticResource Base}" BorderBrush="{StaticResource Surface1}">
            <TabItem x:Name="TabTweaks" Header="Tweaks">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Filters -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock x:Name="LblSearch" Text="Search tweaks" Margin="0,0,0,4"/>
                        <TextBox x:Name="SearchBox" Margin="0,0,0,10"/>
                        <TextBlock x:Name="LblCategory" Text="Category" Margin="0,0,0,4"/>
                        <ListBox x:Name="CategoryList" Height="180" Margin="0,0,0,10"/>
                        <TextBlock x:Name="LblSupported" Text="Supported state" Margin="0,0,0,4"/>
                        <TextBlock x:Name="SupportedSummary" Style="{StaticResource MutedText}" Text="" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button x:Name="BtnRefresh" Content="Refresh state"/>
                        <TextBlock x:Name="RefreshHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" Text=""/>
                    </StackPanel>

                    <!-- Tweak list -->
                    <ListView x:Name="TweakList" Grid.Column="1" SelectionMode="Extended" Margin="0,0,12,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="ColName" Header="Tweak" Width="300" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn x:Name="ColState" Header="State" Width="110" DisplayMemberBinding="{Binding State}"/>
                                <GridViewColumn x:Name="ColCategory" Header="Category" Width="120" DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn x:Name="ColPrivilege" Header="Privileges" Width="90" DisplayMemberBinding="{Binding Privilege}"/>
                                <GridViewColumn x:Name="ColRestart" Header="Restart required" Width="130" DisplayMemberBinding="{Binding Restart}"/>
                                <GridViewColumn x:Name="ColRollback" Header="Rollback" Width="110" DisplayMemberBinding="{Binding Rollback}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Details / pending -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock x:Name="DetailsName" Text="" FontSize="16" Foreground="{StaticResource Blue}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailsDescription" Text="" TextWrapping="Wrap" Margin="0,6,0,6"/>
                            <TextBlock x:Name="DetailsState" Style="{StaticResource MutedText}" Text="" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailsImpact" Style="{StaticResource MutedText}" Text="" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailsManaged" Style="{StaticResource MutedText}" Text="" TextWrapping="Wrap" Foreground="{StaticResource Yellow}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock x:Name="LblTargetState" Text="Target state" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="StateCombo" Width="160" Margin="0,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="BtnAdd" Content="Add to pending"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <TextBlock x:Name="LblPending" Text="Pending changes" Margin="0,0,0,4"/>
                            <ListView x:Name="PendingList" Height="220">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn x:Name="ColPendingTweak" Header="Tweak" Width="230" DisplayMemberBinding="{Binding Tweak}"/>
                                        <GridViewColumn x:Name="ColPendingChange" Header="Change" Width="130" DisplayMemberBinding="{Binding Change}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <CheckBox x:Name="ChkDryRun" Content="Dry run"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="BtnApply" Content="Apply selected" Foreground="{StaticResource Green}"/>
                                <Button x:Name="BtnClear" Content="Cancel"/>
                            </StackPanel>
                            <ProgressBar x:Name="Progress" Height="4" Margin="0,10,0,0" IsIndeterminate="False" Value="0" Background="{StaticResource Surface0}" Foreground="{StaticResource Blue}" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabHistory" Header="Rollback history">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListView x:Name="HistoryList" Grid.Row="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="ColHistTime" Header="Time" Width="210" DisplayMemberBinding="{Binding Timestamp}"/>
                                <GridViewColumn x:Name="ColHistTweak" Header="Tweak" Width="260" DisplayMemberBinding="{Binding TweakId}"/>
                                <GridViewColumn x:Name="ColHistState" Header="State" Width="120" DisplayMemberBinding="{Binding State}"/>
                                <GridViewColumn x:Name="ColHistOutcome" Header="Outcome" Width="120" DisplayMemberBinding="{Binding Outcome}"/>
                                <GridViewColumn x:Name="ColHistRolledBack" Header="Rolled back" Width="110" DisplayMemberBinding="{Binding RolledBack}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="BtnRollback" Content="Roll back selected" Foreground="{StaticResource Yellow}"/>
                        <TextBlock x:Name="LblIrreversible" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap" Text=""/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Text="" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Window>
